# Copy to .env.local and fill in. Nothing here is committed.
#
# Without any of these the app still runs the full demo: the AI routes
# return 500, the client falls back to the pre-verified seed responses,
# and affected cards are tagged "cached". Set them to run live.

# ---- Azure OpenAI (Dev A) ----
# Endpoint origin only, e.g. https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT name you chose in Azure AI Foundry, not the model name.
AZURE_OPENAI_DEPLOYMENT=
# Optional, defaults to 2024-10-21
AZURE_OPENAI_API_VERSION=

# ---- Whop ----
# Checkout link for the facility subscription. Public: it ships to the browser.
NEXT_PUBLIC_WHOP_CHECKOUT_URL=
# Server-side only. Never commit these, never put them in NEXT_PUBLIC_ vars.
WHOP_API_KEY=
# The seller company id, a biz_... value.
WHOP_ACCOUNT_ID=
# Webhook endpoint signing secret from the Whop dashboard. Keep the ws_
# prefix exactly as issued — do not strip it or pre-encode it.
WHOP_WEBHOOK_SECRET=
WHOP_PRODUCT_ID=prod_UBbrTBEoC3xQW
