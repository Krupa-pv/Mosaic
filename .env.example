# Copy to .env.local and fill in. Nothing here is committed.
#
# Without these the app still runs the full demo: every AI route returns
# 500, the client falls back to the pre-verified seed responses, and the
# cards are tagged "cached". Set them to run the pipeline live.

# ---- Azure OpenAI (extraction, match rationale, event fit) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---- Whop ----
# /api/access returns 503 until both are set, and the client treats the
# gate as unwired rather than claiming an active subscription. Only set
# these once the webhook works — once the route answers, an inactive
# subscription hard-blocks the dashboard.
WHOP_API_KEY=
WHOP_COMPANY_ID=

# Checkout link for the subscribe button (public, safe to expose).
NEXT_PUBLIC_WHOP_CHECKOUT_URL=
